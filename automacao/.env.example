# Copie este arquivo para ".env" (mesma pasta) e preencha.
# NUNCA commitar o .env de verdade — ele fica de fora do publish (só index.html
# é copiado pro clone que vai pro GitHub), mas mesmo assim não deixe em lugar
# público.

IMOBMEET_USER=alexandre.lopes@exemplo.com.br
IMOBMEET_PASS=coloque-a-senha-aqui

# Opcionais — só mexer se o padrão não servir:
# IMOBMEET_BASE_URL=https://crm.imobmeet.com.br
# IMOBMEET_LOGIN_URL=https://crm.imobmeet.com.br  (a tela de login É a raiz do site; /login dá "página não encontrada")
# GIT_CLONE_DIR=C:\caminho\para\clone\dedicado\da\automacao
